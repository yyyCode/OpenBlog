<?xml version="1.0" encoding="UTF-8"?>
<!-- 共享日志配置（OpenBlog-common classpath 根路径，所有可部署服务自动生效）。
     console 保留 docker logs 行为；FILE 全量滚动；ERROR_FILE 专收错误，便于快速翻"错误页"根因。 -->
<configuration>
    <!-- spring.application.name：message/gateway 已配置，business 由本方案补齐 -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="openblog"/>
    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] %logger{40} - %msg%n"/>

    <!-- 控制台：与原先 stdout 一致（docker logs 仍可看） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 全量日志：INFO+，按天 + 50MB 滚动，留 14 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${appName}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${appName}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 错误日志：仅 ERROR+，留 30 天，错误页/异常一眼定位 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${appName}-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${appName}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 基础设施压噪：框架自身日志不影响业务可读性 -->
    <logger name="org.apache.dubbo" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="org.apache.rocketmq" level="WARN"/>
    <logger name="com.mysql" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
